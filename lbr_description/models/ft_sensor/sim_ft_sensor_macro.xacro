<?xml version="1.0"?>
<robot name="ft_sensor_OnRobot" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="HEX_E_H_QC_v3" params="parent name *origin">
    
    <joint name="${parent}_${name}_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_base"/>
    </joint>
    
    <link name="${name}_base">
	<inertial>
		<mass value="0.3877"/>
		<origin xyz="-0.0001 -0.0001 0.0053" rpy="0 0 0"/>
        <inertia ixx="0.0" ixy="-0.0" ixz="0.0" iyy="0.0" iyz="-0.0" izz="0.0"/>
	</inertial>
	<visual>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/ft_sensor/meshes/visual/HEX_E_H_QC_v3.dae"/>
		</geometry>
	</visual>
	<collision>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/ft_sensor/meshes/collision/HEX_E_H_QC_v3.stl"/>
		</geometry>
	</collision>
    </link>
    
    <joint name="${name}_base_adapter_joint" type="revolute">
      <origin xyz="0 0 0.05585" rpy="0 0 0"/>
      <parent link="${name}_base"/>
      <child link="${name}_adapter"/>
      <axis xyz="0 0 1" />
      <limit effort="0" velocity="0" lower="0" upper="0" />
    </joint>
    
    <link name="${name}_adapter">
	<inertial>
		<mass value="0.1123"/>
		<origin xyz="0.0003 0.0016 0.001" rpy="0 0 0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="-0.0" izz="0.0"/>
	</inertial>
	<visual>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/ft_sensor/meshes/visual/HEX_E_H_QC_v3_adapter.dae"/>
		</geometry>
	</visual>
	<collision>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/ft_sensor/meshes/collision/HEX_E_H_QC_v3_adapter.stl"/>
		</geometry>
	</collision>
    </link>
    
    </xacro:macro>

</robot>
