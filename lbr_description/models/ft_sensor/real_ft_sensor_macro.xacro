<?xml version="1.0"?>
<robot name="ft_sensor_OnRobot" xmlns:xacro="http://ros.org/wiki/xacro">

	<!-- Common tools: PI, inertias of a cuboid and cylinder -->
	<xacro:property name="M_PI" value="3.1415926535897931"/>
	<xacro:macro name="cuboid_inertia_def" params="width height length mass">
	<inertia ixx="${mass * (height * height + length * length) / 12}"
		 iyy="${mass * (width * width + length * length) / 12}"
		 izz="${mass * (width * width + height * height) / 12}"
		 ixy="0" iyz="0" ixz="0"/>
	</xacro:macro>
	<xacro:macro name="cylinder_inertia_def" params="radius length mass">
	<inertia ixx="${mass * (3 * radius * radius + length * length) / 12}"
		     iyy="${mass * (3 * radius * radius + length * length) / 12}"
		     izz="${mass * radius* radius / 2}"
		     ixy="0" iyz="0" ixz="0"/>
	</xacro:macro>

    <xacro:macro name="brida_cam" params="parent name *origin">
    
    <joint name="${parent}_${name}_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_base"/>
    </joint>
    
    <link name="${name}_base">
	<inertial>
		<mass value="0.05"/>
		<origin xyz="0 0 0.005"  />
		<xacro:cylinder_inertia_def radius="0.031" length="0.01" mass="0.05"/>
	</inertial>
	<visual>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/brida/meshes/visual/brida_cam.dae"/>
		</geometry>
	</visual>
	<collision>
		<!--<origin xyz="0 0 0.005" rpy="0 0 0"/>
		<geometry>
			<cylinder radius="0.031" length="0.01"/>
		</geometry>-->
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/brida/meshes/collision/brida_cam.stl"/>
		</geometry>
	</collision>
    </link>
    
    <link name="${name}_tip"/>
    
    <joint name="${parent}_${name}_tip_joint" type="fixed">
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <parent link="${name}_base"/>
      <child link="${name}_tip"/>
    </joint>
    
    </xacro:macro>

    <xacro:macro name="ft45" params="parent name *origin">
    
    <joint name="${parent}_${name}_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_base"/>
    </joint>
    
    <link name="${name}_base">
	<inertial>
		<mass value="0.15"/>
		<origin xyz="0 0 0.0105"  />
		<xacro:cylinder_inertia_def radius="0.0225" length="0.021" mass="0.15"/>
	</inertial>
	<visual>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/ft_sensor/meshes/visual/FT45.dae"/>
		</geometry>
	</visual>
	<collision>
		<!--<origin xyz="0 0 0.0105" rpy="0 0 0"/>
		<geometry>
			<cylinder radius="0.0225" length="0.021"/>
		</geometry>-->
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/ft_sensor/meshes/collision/FT45.stl"/>
		</geometry>
	</collision>
    </link>
    
    <link name="${name}_tip"/>
    
    <joint name="${parent}_${name}_tip_joint" type="fixed">
      <origin xyz="0 0 0.021" rpy="0 0 0"/>
      <parent link="${name}_base"/>
      <child link="${name}_tip"/>
    </joint>
    
    </xacro:macro>

    <xacro:macro name="brida_ft" params="parent name *origin">
    
    <joint name="${parent}_${name}_base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_base"/>
    </joint>
    
    <link name="${name}_base">
	<inertial>
		<mass value="0.05"/>
		<origin xyz="0 0 0.005"  />
		<xacro:cylinder_inertia_def radius="0.022" length="0.01" mass="0.05"/>
	</inertial>
	<visual>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/brida/meshes/visual/brida_ft.dae"/>
		</geometry>
	</visual>
	<collision>
		<!--<origin xyz="0 0 0.005" rpy="0 0 0"/>
		<geometry>
			<cylinder radius="0.022" length="0.01"/>
		</geometry>-->
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<mesh filename="package://lbr_description/models/brida/meshes/collision/brida_ft.stl"/>
		</geometry>
	</collision>
    </link>
    
    <link name="${name}_tip"/>
    
    <joint name="${parent}_${name}_tip_joint" type="fixed">
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <parent link="${name}_base"/>
      <child link="${name}_tip"/>
    </joint>
    
    </xacro:macro>
    
</robot>
