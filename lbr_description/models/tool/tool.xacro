<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="repair_tool" params="name parent *origin">
    
      <joint name="${name}_base_joint" type="fixed">
        <xacro:insert_block name="origin" />
        <parent link="${parent}"/>
        <child link="${name}_base"/>
      </joint>
      
      <link name="${name}_base">
        <inertial>
          <mass value="0.8" />
          <origin xyz="-0.015887 0 0.036837" rpy="0 0 0" />
          <inertia ixx="0.001143" ixy="-0.0" ixz="-0.000433" iyy="0.002044" iyz="-0.0" izz="0.001124" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
                  <mesh filename="package://lbr_description/models/tool/meshes/visual/Airos150_red_sponge.dae"/>
          </geometry>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://lbr_description/models/tool/meshes/collision/Airos150_red_sponge.stl"/>
          </geometry>
        </collision>
      </link>

    </xacro:macro>

    <xacro:macro name="conditioning_tool" params="name parent *origin">
    
      <joint name="${name}_brida_joint" type="fixed">
        <xacro:insert_block name="origin" />
        <parent link="${parent}"/>
        <child link="${name}_base"/>
      </joint>
      
      <link name="${name}_base">
        <inertial>
          <mass value="0.110" />
          <origin xyz="-0.009159 -0.01474 0.093085" rpy="0 0 0" />
          <inertia ixx="0.002444" ixy="-0.000123" ixz="-0.000103" iyy="0.003024" iyz="-5.1e-05" izz="0.001237" />
        </inertial>
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
                  <mesh filename="package://lbr_description/models/tool/meshes/visual/Airos350CV_brida_red_sponge.dae"/>
          </geometry>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://lbr_description/models/tool/meshes/collision/Airos350CV_brida_red_sponge.stl"/>
          </geometry>
        </collision>
      </link>
    
