<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="skid" params="prefix">
	  <!-- World frame (for Gazebo) -->
	  <link name="world"/>

	  <!-- Cell fixed to world frame  -->
	  <joint name="base_joint" type="fixed">
	      <origin xyz="0 0 0" rpy="0 0 0" />
	      <parent link="world" />
	      <child link="${prefix}_base"/>
	  </joint>

	  <link name="${prefix}_base">
	      <inertial>
		  <mass value="174.616" />
		  <origin xyz="0.0016 0.0009 -0.2162" rpy="0 0 0" />
		  <inertia ixx="23.1841" ixy="-0.001" ixz="-0.0005" iyy="397.0265" iyz="0.0065" izz="414.8514" />
	      </inertial>
	      <visual name="visual">
		<geometry>
		  <mesh filename="package://kuka_control/models/${prefix}/meshes/Visual/OT-2575 Instalacion_IDF_Skid.dae"/>
		</geometry>
	      </visual>
	  </link>
	  
	  <gazebo>
	    <static>true</static>
	  </gazebo>
  </xacro:macro>

</robot>
