<?xml version="1.0" ?>
<model>
    <name>screen_ghost</name>
    <version>1.0.0</version>
    <sdf version="1.8">model.sdf</sdf>
    <author>
        <name>lbr_stack</name>
    </author>
    <description>
        Independent collision-only ghost model of the screen surface.
        Placed at the same world pose as the screen on lbr_base_link
        to enable collision detection with the sponge tool.
    </description>
</model>
