<?xml version="1.0" ?>

<!-- top level -->
<robot name="iiwa14" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_mass" value="40.0" />
    <xacro:property name="robot_offset_x" value="0.40" />
    <xacro:property name="robot_offset_y" value="0.0" />
    <xacro:property name="base_ixx" value="5.333" />
    <xacro:property name="base_iyy" value="5.600" />
    <xacro:property name="base_izz" value="5.467" />

    <!-- include the iiwa macro and controller -->
    <xacro:include filename="$(find lbr_description)/urdf/iiwa14/iiwa14.urdf.xacro" />
    <xacro:include filename="$(find lbr_description)/gazebo/lbr_gazebo.xacro" />
    <xacro:include filename="$(find lbr_description)/ros2_control/lbr_system_interface.xacro" />
    <xacro:include
        filename="$(find lbr_description)/models/ft_sensor/real_ft_sensor_macro.xacro"
    />
    <xacro:include filename="$(find lbr_description)/models/tool/tool.xacro" />

    <!-- arguments -->
    <xacro:arg name="robot_name" default="lbr" />
    <xacro:arg name="mode" default="true" />
    <xacro:arg
        name="joint_limits_path"
        default="$(find lbr_description)/urdf/iiwa14/joint_limits.yaml" />
    <xacro:arg
        name="system_config_path"
        default="$(find lbr_description)/ros2_control/lbr_system_config.yaml" />
    <xacro:arg
        name="initial_joint_positions_path"
        default="$(find lbr_description)/ros2_control/initial_joint_positions.yaml" />

    <xacro:macro
        name="ft_gazebo_plugin"
        params="ft_joint_name topic_name update_rate:='1000' noise_stddev_force:='0.01' noise_stddev_torque:='0.001'"
    >
        <gazebo reference="${ft_joint_name}">
            <preserveFixedJoint>true</preserveFixedJoint>
            <sensor name="ft_sensor" type="force_torque">
                <always_on>true</always_on>
                <update_rate>${update_rate}</update_rate>
                <visualize>false</visualize>
                <force_torque>
                    <frame>child</frame>
                    <measure_direction>child_to_parent</measure_direction>
                    <force>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev
                                >${noise_stddev_force}</stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev
                                >${noise_stddev_force}</stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev
                                >${noise_stddev_force}</stddev></noise></z>
                    </force>
                    <torque>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev
                                >${noise_stddev_torque}</stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev
                                >${noise_stddev_torque}</stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev
                                >${noise_stddev_torque}</stddev></noise></z>
                    </torque>
                </force_torque>
                <topic>${topic_name}</topic>
                <plugin
                    filename="gz-sim-forcetorque-system"
                    name="gz::sim::systems::ForceTorque"
                />
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- KDL requires a link without inertia / Gazebo requires a connection to world link or robot
    will tipple https://github.com/lbr-stack/lbr_fri_ros2_stack/issues/230 -->
    <link name="world" />

    <!-- base_link between world and link_0 -->
    <link name="$(arg robot_name)_base_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="${base_mass}" />
            <inertia
                ixx="${base_ixx}"
                ixy="0.0"
                ixz="0.0"
                iyy="${base_iyy}"
                iyz="0.0"
                izz="${base_izz}"
            />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh
                    filename="package://lbr_description/meshes/iiwa14/carrito_azul/Cuerpo_carro_1.dae"
                />
            </geometry>
        </visual>
        <!-- simplified box for collision optimization -->
        <!-- <collision>
            <origin xyz="0 0 -0.33" rpy="0 0 0" />
            <geometry>
                <box size="1.055 0.705 0.660" />
            </geometry>
        </collision> -->
        <collision>
            <origin xyz="-0.2195 0 0.1615" rpy="0 0 0" />
            <geometry>
                <box size="0.389 0.705 0.323" />
            </geometry>
        </collision>
    </link>

    <!-- joint between world and base_link -->
    <joint name="$(arg robot_name)_world_joint" type="fixed">
        <parent link="world" />
        <child link="$(arg robot_name)_base_link" />
        <origin xyz="0 0 0.660" rpy="0 0 0" />
    </joint>

    <!-- joint between base_link and link_0 -->
    <joint name="$(arg robot_name)_base_robot_joint" type="fixed">
        <parent link="$(arg robot_name)_base_link" />
        <child link="$(arg robot_name)_link_0" />
        <origin xyz="${robot_offset_x} ${robot_offset_y} 0" rpy="0 0 ${pi/2}" />
    </joint>

    <!-- macros for gazebo / mock / hardware -->
    <xacro:lbr_gazebo robot_name="$(arg robot_name)" />
    <xacro:lbr_system_interface
        robot_name="$(arg robot_name)"
        mode="$(arg mode)"
        system_config_path="$(arg system_config_path)"
        initial_joint_positions_path="$(arg initial_joint_positions_path)" />

    <!-- iiwa description -->
    <xacro:iiwa14
        robot_name="$(arg robot_name)"
        joint_limits_path="$(arg joint_limits_path)" />


    <xacro:brida_cam parent="$(arg robot_name)_link_7" name="brida_cam">
        <origin xyz="0 0 0.035" rpy="0 0 0" />
    </xacro:brida_cam>

    <xacro:ft45 parent="brida_cam_tip" name="ft45">
        <origin xyz="0 0 0" rpy="0 0 ${pi}" />
    </xacro:ft45>

    <!-- plugin FT sobre joint: brida_cam_tip_ft45_base_joint -->
    <xacro:ft_gazebo_plugin
        ft_joint_name="brida_cam_tip_ft45_base_joint"
        topic_name="ft_sensor/wrench"
        update_rate="200"
    /> 

    <xacro:brida_ft parent="ft45_tip" name="brida_ft">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:brida_ft>

    <xacro:repair_tool_iiwa name="tool_body" parent="brida_ft_tip">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:repair_tool_iiwa>

    <xacro:repair_sponge_red name="tool" parent="tool_body_tip">
        <origin xyz="0 0 0" rpy="0 0 ${pi}" />
    </xacro:repair_sponge_red>

    <joint name="$(arg robot_name)_joint_ee" type="fixed">
        <parent link="tool_tip" />
        <child link="$(arg robot_name)_link_ee" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <link name="$(arg robot_name)_link_ee">
    </link>

    <!-- camera link 7 -->
    <!-- <gazebo reference="brida_cam_base">
        <kp>100000.0</kp>
        <kd>100.0</kd>
        <mu1>0.5</mu1>
        <mu2>0.3</mu2>
    </gazebo> -->

    <!-- Sensor FT45 -->
    <!-- <gazebo reference="ft45_base">
        <kp>100000.0</kp>
        <kd>100.0</kd>
        <mu1>0.5</mu1>
        <mu2>0.3</mu2>
    </gazebo> -->

    <!-- Brida FT -->
    <!-- <gazebo reference="brida_ft_base">
        <kp>100000.0</kp>
        <kd>100.0</kd>
        <mu1>0.5</mu1>
        <mu2>0.3</mu2>
    </gazebo> -->

    <!-- Tool body (base de la esponja) -->
    <gazebo reference="tool_body_base">
        <kp>5000.0</kp>
        <kd>50.0</kd>
        <mu1>1.0</mu1>
        <mu2>0.8</mu2>
    </gazebo>

    <!-- Tool (sponge) -->
    <gazebo reference="tool_base">
        <provideFeedback>true</provideFeedback>
        <kp>5000.0</kp>            <!-- stiffness low -->
        <kd>50.0</kd>              <!-- damping moderate -->
        <mu1>1.0</mu1>             <!-- high friction sponge-screen -->
        <mu2>0.8</mu2>
        <maxVel>0.01</maxVel>
        <minDepth>0.0001</minDepth>
        <maxContacts>6</maxContacts>
    </gazebo>

</robot>
